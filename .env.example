# Copy to .env and adjust. Never commit .env.

# SQLite database file (Prisma). Relative paths resolve from the project root.
DATABASE_URL="file:./data/hrm.db"

# Folder for the database, uploaded originals and backups (git-ignored).
DATA_DIR="./data"

# Session lifetime (ADR-005).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Upload limits (ADR-008).
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_UNCOMPRESSED_BYTES=52428800

# Optional, comma-separated. Every address other than localhost that people open the app on:
# a LAN address (http://10.0.6.70:3000) or a reverse proxy (https://hrm.example.com).
# Restart the server after changing it.
TRUSTED_ORIGINS=

# Display time zone for timestamps.
APP_TIMEZONE="Asia/Kathmandu"

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# First HR Admin — used only by `npm run seed:admin`, then remove from the environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_TELEMETRY_DISABLED=1
